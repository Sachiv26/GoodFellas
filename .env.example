# Database (PostgreSQL)
DATABASE_URL=

# Authentication (jose JWT + httpOnly cookies)
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=goodfellas_session

# Application
APP_URL=

# Private document storage â€” NEVER use /public for uploads.
# provider: local (development) | s3 (production, S3-compatible)
STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/private
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# OCR / barcode extraction (free & open-source only)
OCR_ENGINE=tesseract
# Optional AI extraction: tesseract | gemini | cohere
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
COHERE_API_KEY=
COHERE_MODEL=command-a-vision-07-2025
TESSERACT_CACHE_DIR=./tessdata
TESSERACT_LANG=eng
BARCODE_ENGINE=zxing

# Payment gateway (Ozow-ready; no live payments until configured)
PAYMENT_PROVIDER=ozow
OZOW_MERCHANT_ID=
OZOW_API_KEY=
OZOW_API_URL=https://api.ozow.com/v1

# Upload limits
MAX_UPLOAD_BYTES=10485760
