# Database (PostgreSQL)
DATABASE_URL=

# Authentication (jose JWT + httpOnly cookies)
JWT_SECRET=
JWT_EXPIRES_IN=7d
SESSION_COOKIE_NAME=goodfellas_session

# Application
APP_URL=

# Private document storage - NEVER use /public for uploads.
# provider: blob (Vercel production) | local (development) | s3 (S3-compatible)
# Vercel: set STORAGE_PROVIDER=blob and add BLOB_READ_WRITE_TOKEN to the Vercel
# project environment variables. Blobs are written as private, so a blob URL
# is not publicly readable; downloads still go through the authenticated routes.
STORAGE_PROVIDER=local
BLOB_READ_WRITE_TOKEN=
# Only used when STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=./storage/private
# Only used when STORAGE_PROVIDER=s3
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_ENDPOINT=

# Barcode decoding (local & open-source only).
# There is NO OCR and NO AI/vision provider in this application: the licence disc
# barcode is the only machine-readable document data source, and it is decoded in
# the user's browser with ZXing before being posted to the server.
BARCODE_ENGINE=zxing
# Cache dir retained for the shared image preprocessing helpers.
TESSERACT_CACHE_DIR=./tessdata

# Drain pending document-processing jobs.
# The upload route hands processing to a background worker and does not wait for
# it, so a serverless runtime can discard that work. This cron is the durable
# safety net: anything still PENDING is picked up here.
# Required — the endpoint returns 503 and refuses to run without it.
CRON_SECRET=

# Payment gateway (Ozow-ready; no live payments until configured)
PAYMENT_PROVIDER=ozow
OZOW_MERCHANT_ID=
OZOW_API_KEY=
OZOW_API_URL=https://api.ozow.com/v1

# Upload limits
MAX_UPLOAD_BYTES=10485760
