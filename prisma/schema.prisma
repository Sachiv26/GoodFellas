model Document {
  id               String         @id @default(cuid())
  applicationId    String
  application      Application                 @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  requirementId    String?
  requirement      ProductDocumentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  documentTypeId   String
  documentType     DocumentType                @relation(fields: [documentTypeId], references: [id], onDelete: Restrict)
  storageKey       String
  originalFileName String
  mimeType         String
  fileSize         Int
  checksum         String?
  status           DocumentStatus @default(UPLOADED)
  replacedById     String?        @unique
  uploadedById     String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  processingJobs ProcessingJob[]
  extractions    DocumentExtraction[]
  barcodes       BarcodeExtraction[]
  replacedBy     Document?            @relation("DocumentReplaces", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces       Document?            @relation("DocumentReplaces")

  @@index([applicationId])
  @@index([status])
  @@map("documents")
}

model ProcessingJob {
  id            String              @id @default(cuid())
  documentId    String?
  document      Document?           @relation(fields: [documentId], references: [id], onDelete: Cascade)
  applicationId String?
  type          ProcessingJobType
  status        ProcessingJobStatus @default(PENDING)
  attempts      Int                 @default(0)
  maxAttempts   Int                 @default(3)
  payload       Json                @default("{}")
  result        Json?
  error         String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([status, type])
  @@index([documentId])
  @@map("processing_jobs")
}

model BarcodeExtraction {
  id              String   @id @default(cuid())
  documentId      String
  document        Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  symbology       String
  rawValue        String
  decodedDataJson Json     @default("{}")
  confidence      Float
  decodedAt       DateTime @default(now())

  @@index([documentId])
  @@map("barcode_extractions")
}

model DocumentExtraction {
  id                String           @id @default(cuid())
  documentId        String
  document          Document             @relation(fields: [documentId], references: [id], onDelete: Cascade)
  extractionVersion String
  status            ExtractionStatus @default(PENDING)
  rawText           String?          @db.Text
  extractedJson     Json             @default("{}")
  confidence        Float?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  fieldExtractions DocumentFieldExtraction[]

  @@index([documentId])
  @@map("document_extractions")
}

model DocumentFieldExtraction {
  id               String                @id @default(cuid())
  extractionId     String
  extraction       DocumentExtraction    @relation(fields: [extractionId], references: [id], onDelete: Cascade)
  fieldName        String
  value            String?
  normalizedValue  String?
  confidence       Float?
  source           ExtractionSource      @default(OCR)
  boundingBox      Json?
  validationStatus FieldValidationStatus @default(UNKNOWN)
  validationNotes  String?               @db.Text
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  corrections ManualCorrection[]
  @@unique([extractionId, fieldName])
  @@index([extractionId])
  @@map("document_field_extractions")
}

model ManualCorrection {
  id                String   @id @default(cuid())
  applicationId     String
  application       Application              @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fieldExtractionId String?
  fieldExtraction   DocumentFieldExtraction? @relation(fields: [fieldExtractionId], references: [id], onDelete: SetNull)
  fieldName         String
  oldValue          String?
  newValue          String?
  reason            String?
  adminId           String
  createdAt         DateTime @default(now())

  @@index([applicationId])
  @@map("manual_corrections")
}

model CrossDocumentValidation {
  id            String                @id @default(cuid())
  applicationId String
  application   Application           @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  ruleKey       String
  status        CrossValidationStatus @default(NEEDS_REVIEW)
  detailsJson   Json                  @default("{}")
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@unique([applicationId, ruleKey])
  @@index([applicationId])
  @@map("cross_document_validations")
}

