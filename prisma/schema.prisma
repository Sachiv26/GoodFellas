model PricingComponent {
  id        String               @id @default(cuid())
  productId String
  product   Product              @relation(fields: [productId], references: [id], onDelete: Cascade)
  code      String
  name      String
  kind      PricingComponentKind
  label     String
  active    Boolean              @default(true)
  version   Int                  @default(1)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  rules PricingRule[]

  @@unique([productId, code])
  @@index([productId])
  @@map("pricing_components")
}

model PricingRule {
  id            String           @id @default(cuid())
  componentId   String
  component     PricingComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  version       Int              @default(1)
  name          String
  active        Boolean          @default(true)
  effectiveFrom DateTime         @default(now())
  effectiveTo   DateTime?
  expr          String           @db.Text
  priority      Int              @default(100)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@unique([componentId, version])
  @@map("pricing_rules")
}

model PricingLookupTable {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entries PricingLookupEntry[]

  @@map("pricing_lookup_tables")
}

model PricingLookupEntry {
  id       String             @id @default(cuid())
  tableId  String
  table    PricingLookupTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  key      String
  label    String
  minValue Float?
  maxValue Float?
  amount   Float
  active   Boolean            @default(true)
  metaData Json?

  @@unique([tableId, key])
  @@map("pricing_lookup_entries")
}

model PriceCalculation {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  version       Int         @default(1)
  currency      String      @default("ZAR")
  total         Decimal     @db.Decimal(12, 2)
  breakdown     Json
  inputs        Json
  createdBy     String?
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("price_calculations")
}

