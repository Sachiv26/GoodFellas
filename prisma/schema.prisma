  authorId      String
  content       String      @db.Text
  internal      Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("admin_notes")
}

model AuditLog {
  id        String    @id @default(cuid())
  actorId   String?
  actorRole UserRole?
  action    String
  entity    String
  entityId  String?
  metaData  Json?
  ipAddress String?
  createdAt DateTime  @default(now())

  @@index([entity, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

