model TareLicenceFee {
  id                 String   @id @default(cuid())
  vehicleType        String
  minWeightKg        Int
  maxWeightKg        Int
  licenceFee         Decimal  @db.Decimal(12, 2)
  rigidVehicleFee    Decimal? @db.Decimal(12, 2)
  breakdownVehicleFee Decimal? @db.Decimal(12, 2)
  tractorFee         Decimal? @db.Decimal(12, 2)
  trailerFee         Decimal? @db.Decimal(12, 2)
  source             String   @default("TARE.txt")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  @@unique([vehicleType, minWeightKg, maxWeightKg])
  @@index([vehicleType, minWeightKg, maxWeightKg])
  @@map("tare_licence_fees")
}

model PaymentAttempt {
  id            String        @id @default(cuid())
  applicationId String
  application   Application   @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      String        @default("ozow")
  reference     String        @unique
  amount        Decimal       @db.Decimal(12, 2)
  currency      String        @default("ZAR")
  status        String        @default("PENDING")
  checkoutUrl   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@index([applicationId, createdAt])
  @@map("payment_attempts")
}

model PdfTemplate {
  id          String           @id @default(cuid())
  name        String
  code        String           @unique
  description String?
  storageKey  String
  pageCount   Int              @default(0)
  hasAcroForm Boolean          @default(false)
  active      Boolean          @default(true)
  version     Int              @default(1)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  mappings  PdfFieldMapping[]
  generated GeneratedDocument[]

  @@map("pdf_templates")
}

model PdfFieldMapping {
  id           String         @id @default(cuid())
  templateId   String
  template     PdfTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)
  section      String
  pdfFieldName String
  sourcePath   String
  kind         PdfMappingKind @default(TEXT)
  layout       PdfFieldLayout @default(TEXT)
  coordinates  Json?
  format       String?
  active       Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([templateId, pdfFieldName])
  @@map("pdf_field_mappings")
}

model GeneratedDocument {
  id            String      @id @default(cuid())
  applicationId String
  application   Application  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  templateId    String?
  template      PdfTemplate? @relation(fields: [templateId], references: [id])
  storageKey    String      @unique
  fileName      String
  mimeType      String      @default("application/pdf")
  createdBy     String
  extractionSnapshot Json       @default("{}")

  createdAt     DateTime    @default(now())

  @@index([applicationId])
  @@map("generated_documents")
}

